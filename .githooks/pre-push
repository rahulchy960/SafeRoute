#!/bin/sh
# SafeRoute pre-push hook: rejects any push that targets main (Plan v7 §17.2).
# Enabled with: git config core.hooksPath .githooks
#
# Git calls this hook as: pre-push <remote-name> <remote-url>
# and writes one line per ref being pushed to stdin:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# Every change to main goes through a pull request that Rahul merges on GitHub.

remote="$1"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ -z "$remote_ref" ] && continue
	if [ "$remote_ref" = "refs/heads/main" ]; then
		echo "pre-push: REJECTED push to refs/heads/main on '${remote:-?}' (local ref: ${local_ref:-?})." >&2
		echo "pre-push: main is protected. Push your branch and open a pull request:" >&2
		echo "pre-push:   git push -u origin <type>/<NNN>-<core-work>" >&2
		status=1
	fi
done

exit $status
