<!--
    What the launcher needs to know about the widget (P014c1).
    2 x 2 cells and not resizable: big enough to hit in a hurry, and it cannot be shrunk to a
    1 x 1 square that a passing thumb would tap. (The cell attributes are read from Android
    12; older launchers use the dp sizes.)
    updatePeriodMillis=0: the widget never changes, so the app is never woken to redraw it.
    home_screen: it is not offered for the lock screen.
    previewLayout (Android 12 and newer) shows the real layout in the widget picker;
    previewImage is what older launchers show.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/sos_widget_picker_description"
    android:initialLayout="@layout/emergency_widget"
    android:minHeight="110dp"
    android:minWidth="110dp"
    android:previewImage="@drawable/emergency_widget_button"
    android:previewLayout="@layout/emergency_widget"
    android:resizeMode="none"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
