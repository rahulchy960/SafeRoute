<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        A permission is added only by the prompt whose feature needs it (CLAUDE.md "Android
        rules"). INTERNET (P008): lets the app open network connections to the SafeRoute API.
        It is a "normal" permission: granted at install, no dialog, nothing for the user to do.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Location (P010b), to show where you are on the map. These are "dangerous" permissions:
        declaring them here only makes it possible to ASK. Android shows its dialog when the
        app requests them at runtime, which happens only after the user taps "my location" and
        has read the app's own explanation (Plan v7 12.3). Both are declared because since
        Android 12 the user may choose "approximate", which grants only the coarse one.
        Used in the foreground only. ACCESS_BACKGROUND_LOCATION is deliberately absent, and so
        are the foreground-service permissions (Plan v7 5.3, ADR 0015).
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        The pinned emergency notification (P012f2), an optional shortcut the user switches on.
        POST_NOTIFICATIONS: from Android 13 a "dangerous" permission. Declaring it only makes
        it possible to ASK; the app asks only after the user turned the shortcut on in
        Settings and read the app's own explanation. Older versions need no request.
        RECEIVE_BOOT_COMPLETED: a "normal" permission (no dialog). It lets Android tell the app
        that the phone has restarted, so the notification can be put back, and only if the
        user's switch is on. Nothing else runs at boot, and no service is started.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        The map library (MapLibre, P010a) declares this one in its own manifest, and Android
        merges library manifests into the app's. The app does not need it, so it is taken out
        again. tools:node="remove" means "leave this out of the merged manifest".
    -->
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        tools:node="remove" />

    <!--
        Package visibility (P013b2). Since Android 11 an app must say which other apps it
        wants to be able to find. This entry lets the app hand an invite to the phone's SMS
        app (ACTION_SENDTO, smsto:), where the user reads it and sends it. It is NOT a
        permission: the app cannot send an SMS (no SEND_SMS) and cannot read any.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <!--
        allowBackup=false + data_extraction_rules: nothing the app stores is copied to a cloud
        backup or to a new phone (ADR 0008). Restoring an old SOS record or session blindly
        would be worse than starting clean.
        localeConfig: the languages offered under Settings > Apps > SafeRoute > Language
        (Android 13+). Older versions follow the system language.
        enableOnBackInvokedCallback: opts in to the predictive back gesture.
        networkSecurityConfig: HTTPS only, system certificate authorities only
        (res/xml/network_security_config.xml, ADR 0009).
        tools:targetApi: tells lint that the two attributes above are meant for Android 13+
        and are simply ignored on older versions.
    -->
    <application
        android:name=".SafeRouteApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeRoute"
        tools:targetApi="33">

        <!--
            The only activity (single-activity app): every screen is a Compose destination
            inside it. `exported` must be true for the launcher to start it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeRoute.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Where the emergency shortcuts outside the app lead (P012f): the same dialog as the
            in-app SOS control, and nothing else.
            exported=false: only this app's own tile (and later its notification) start it.
            showWhenLocked: it may appear on top of the lock screen. That is safe for this
            screen only: fixed text and a button that opens the dialer with 112. It unlocks
            nothing, and MainActivity never has this attribute (a test checks both).
            excludeFromRecents + its own taskAffinity: it is a moment, not a place to return
            to; it does not show up in the recent-apps list or on top of the main screen.
        -->
        <activity
            android:name=".feature.emergency.EmergencyActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:taskAffinity="com.saferoute.app.emergency"
            android:theme="@style/Theme.SafeRoute"
            tools:targetApi="27" />

        <!--
            The "SafeRoute SOS" Quick Settings tile (P012f). Not a service that keeps running:
            Android binds it for a moment when the tile is added or tapped.
            permission BIND_QUICK_SETTINGS_TILE: only the system may bind it. It is a
            permission this component REQUIRES of its caller, not one the app asks for, so the
            app's own permission list does not change.
            exported=true: the system must be able to reach it (and to offer it to the user).
            ACTIVE_TILE: Android wakes the service for a tap, not each time the panel opens.
        -->
        <service
            android:name=".feature.emergency.SosTileService"
            android:exported="true"
            android:icon="@drawable/ic_sos_tile"
            android:label="@string/sos_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!--
            Puts the pinned emergency notification back after a restart of the phone and after
            an update of the app (both remove notifications), and only if the user's switch is
            on and notifications are allowed (P012f2).
            exported=false: only the system delivers these two broadcasts; no other app can
            reach the receiver. It starts no activity and no service.
        -->
        <receiver
            android:name=".feature.emergency.EmergencyShortcutReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
