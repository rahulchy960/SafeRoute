<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        A permission is added only by the prompt whose feature needs it (CLAUDE.md "Android
        rules"). INTERNET (P008): lets the app open network connections to the SafeRoute API.
        It is a "normal" permission: granted at install, no dialog, nothing for the user to do.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        The map library (MapLibre, P010a) declares these three in its own manifest, and Android
        merges library manifests into the app's. The app does not use them yet, so they are
        taken out again: the map draws without them. Location arrives with its own prompt
        (P010b), together with the screen that explains it; that prompt deletes the two
        location lines below. Wi-Fi state is not needed at all.
        tools:node="remove" means "leave this out of the merged manifest".
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        tools:node="remove" />

    <!--
        allowBackup=false + data_extraction_rules: nothing the app stores is copied to a cloud
        backup or to a new phone (ADR 0008). Restoring an old SOS record or session blindly
        would be worse than starting clean.
        localeConfig: the languages offered under Settings > Apps > SafeRoute > Language
        (Android 13+). Older versions follow the system language.
        enableOnBackInvokedCallback: opts in to the predictive back gesture.
        networkSecurityConfig: HTTPS only, system certificate authorities only
        (res/xml/network_security_config.xml, ADR 0009).
        tools:targetApi: tells lint that the two attributes above are meant for Android 13+
        and are simply ignored on older versions.
    -->
    <application
        android:name=".SafeRouteApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SafeRoute"
        tools:targetApi="33">

        <!--
            The only activity (single-activity app): every screen is a Compose destination
            inside it. `exported` must be true for the launcher to start it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SafeRoute.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
