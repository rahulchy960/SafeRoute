    "/v1/me/consents/{purpose}": {
      "put": {
        "operationId": "setMyConsent",
        "tags": [
          "me"
        ],
        "summary": "Grant or withdraw consent for one purpose",
        "description": "Records the decision and returns the latest state; safe to retry. Ask just-in-time, when the feature that needs the purpose is first used. Errors: `validation_error` (400) for an unknown purpose; `account_deletion_required` (409) when withdrawing `account_core`, which can only be withdrawn by deleting the account.",
        "security": [
          {
            "firebaseBearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,40}$",
              "description": "What the consent is for. Open set; currently accepted: `account_core`, `sos_alerts`, `live_sharing`, `safety_reports`.",
              "examples": [
                "account_core"
              ]
            },
            "required": true,
            "description": "What the consent is for. Open set; currently accepted: `account_core`, `sos_alerts`, `live_sharing`, `safety_reports`.",
            "name": "purpose",
            "in": "path"
          }
