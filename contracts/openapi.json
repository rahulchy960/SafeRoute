{
  "openapi": "3.1.0",
  "info": {
    "title": "SafeRoute API",
    "version": "0.7.0",
    "description": "SafeRoute is a personal-safety navigation API. Safety information is context, never a guarantee that a route or area is safe. SafeRoute is not an emergency service; in an emergency call your local emergency number (112 in India).",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "operational",
      "description": "Unversioned probes for the platform (liveness, readiness). Not for app features."
    },
    {
      "name": "me",
      "description": "The signed-in user's own account and consents. Every operation needs a Firebase ID token (phone sign-in)."
    },
    {
      "name": "search",
      "description": "Place search through a geocoding provider. Queries are rate-limited and are not stored or logged."
    },
    {
      "name": "routing",
      "description": "Walking and driving routes between two points, computed from OpenStreetMap data. Origins, destinations and routes are not stored or logged. A route is a way to travel, never a statement that it is safe."
    }
  ],
  "components": {
    "headers": {
      "RequestId": {
        "description": "Correlation ID for this request. Echoes a well-formed incoming `X-Request-Id` (8–64 characters of `A–Z a–z 0–9 . _ -`), otherwise a fresh UUID.",
        "schema": {
          "type": "string"
        }
      },
      "CacheControlNoStore": {
        "description": "Always `no-store`: the response must never be cached.",
        "schema": {
          "type": "string",
          "enum": [
            "no-store"
          ]
        }
      },
      "WwwAuthenticate": {
        "description": "Always `Bearer`: send a Firebase ID token as `Authorization: Bearer <token>`.",
        "schema": {
          "type": "string",
          "enum": [
            "Bearer"
          ]
        }
      },
      "RetryAfter": {
        "description": "Whole seconds to wait before trying again. Present when the server knows how long (a rate limit); absent otherwise.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input (`validation_error`).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid credentials (`unauthorized`). Refresh the ID token and retry once.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "WWW-Authenticate": {
            "$ref": "#/components/headers/WwwAuthenticate"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated but not allowed: `forbidden`, `bootstrap_required`, `account_deleted`, `consent_required` or `adult_required`. Final: retrying the same request does not help.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such route or resource (`not_found`), or no way between two places (`no_route_found`).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflicts with the current state (`conflict`, `phone_already_registered`, `account_deletion_required`).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Gone": {
        "description": "The resource existed but has expired or ended (`gone`).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "UnprocessableContent": {
        "description": "The input is well-formed but cannot be served: `outside_covered_area`, `route_too_long` or `location_not_routable`. Final for this input: change it instead of retrying.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded (`rate_limited`). Wait for `Retry-After` seconds.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error (`internal_error`).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "A dependency is unavailable (e.g. `db_unavailable`, `db_not_configured`, `auth_unavailable`, `auth_not_configured`, `search_unavailable`, `search_not_configured`, `routing_unavailable`, `routing_not_configured`). Retry with backoff, or after `Retry-After` when it is sent.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "firebaseBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase ID token from phone sign-in, sent as `Authorization: Bearer <token>`. 401 → refresh the token and retry once; 503 `auth_unavailable` → retry with backoff."
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Problem type URI. `about:blank` means `title` is the HTTP status phrase.",
            "examples": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string",
            "examples": [
              "Not Found"
            ]
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "examples": [
              404
            ]
          },
          "detail": {
            "type": "string",
            "description": "Human-readable, generic explanation. Never contains personal data.",
            "examples": [
              "No route matches this request."
            ]
          },
          "code": {
            "type": "string",
            "description": "Stable, machine-readable error code; clients switch on this, not on `title` or `detail`. Open set: clients must tolerate unknown values. Currently defined: `validation_error`, `unauthorized`, `forbidden`, `bootstrap_required`, `account_deleted`, `consent_required`, `adult_required`, `not_found`, `conflict`, `phone_already_registered`, `account_deletion_required`, `gone`, `rate_limited`, `internal_error`, `db_unavailable`, `db_not_configured`, `auth_unavailable`, `auth_not_configured`, `search_unavailable`, `search_not_configured`, `outside_covered_area`, `route_too_long`, `location_not_routable`, `no_route_found`, `routing_unavailable`, `routing_not_configured`, `http_error`.",
            "examples": [
              "not_found"
            ]
          },
          "requestId": {
            "type": "string",
            "description": "Same value as the `X-Request-Id` response header; quote it in bug reports.",
            "examples": [
              "3f2c1b9e-7a44-4c1e-9d2f-0b6a5e8c1d23"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "description": "Present for `validation_error`: one entry per invalid input."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "requestId"
        ],
        "description": "Error body for every 4xx/5xx response (media type `application/problem+json`)."
      },
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Location of the invalid input, e.g. `body.contacts.0.name` or `query.limit`.",
            "examples": [
              "body.name"
            ]
          },
          "code": {
            "type": "string",
            "description": "Why it is invalid (e.g. `invalid_type`, `too_small`). Open set.",
            "examples": [
              "invalid_type"
            ]
          }
        },
        "required": [
          "path",
          "code"
        ],
        "description": "One invalid input. Never contains the submitted value."
      },
      "IdempotencyKey": {
        "type": "string",
        "minLength": 16,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._-]{16,64}$",
        "description": "Client-generated key (e.g. a UUID) for a retryable state-changing call. The server stores key → response for 24 h and replays the stored response for a repeat (Plan v7 §6.2).",
        "examples": [
          "2b1f6c4e-8d3a-4f7b-9c21-5e0a7d4b3c19"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "examples": [
              "saferoute-api"
            ]
          },
          "version": {
            "type": "string",
            "description": "Deployed build version of the service (not the contract version).",
            "examples": [
              "0.1.0"
            ]
          },
          "uptimeSeconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Seconds since this instance started.",
            "examples": [
              42
            ]
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "uptimeSeconds"
        ]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "ok"
                ]
              }
            },
            "required": [
              "database"
            ],
            "description": "One entry per dependency this instance needs to serve traffic."
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Stable account ID.",
            "examples": [
              "0f8c2a4e-6b1d-4c3a-9e7f-2d5b8a1c4e60"
            ]
          },
          "phoneE164": {
            "type": [
              "string",
              "null"
            ],
            "description": "Verified phone number in E.164 form, from the sign-in token.",
            "examples": [
              "+910000000001"
            ]
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "Sample Name"
            ]
          },
          "locale": {
            "type": "string",
            "description": "UI language: `en` or `bn`. Clients must tolerate unknown values.",
            "examples": [
              "en"
            ]
          },
          "role": {
            "type": "string",
            "description": "`user`, `moderator` or `admin`. Clients must tolerate unknown values.",
            "examples": [
              "user"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 UTC timestamp.",
            "examples": [
              "2026-10-01T09:30:00.000Z"
            ]
          }
        },
        "required": [
          "id",
          "phoneE164",
          "displayName",
          "locale",
          "role",
          "createdAt"
        ],
        "description": "The signed-in user's account."
      },
      "BootstrapMeRequest": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "bn"
            ],
            "description": "UI language for the new account. Default `en`. Ignored if it already exists.",
            "examples": [
              "bn"
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Name shown to the user's emergency contacts. Trimmed; 1–80 characters; no control characters. Ignored if the account already exists.",
            "examples": [
              "Sample Name"
            ]
          },
          "consent": {
            "$ref": "#/components/schemas/BootstrapConsent"
          }
        },
        "description": "Settings and consent for a new account. `consent` is needed to create an account (optional in the schema only because an existing account does not need it). The phone number is never sent: the server takes it from the verified ID token. Unknown properties are ignored."
      },
      "BootstrapConsent": {
        "type": "object",
        "properties": {
          "ageConfirmed": {
            "type": "boolean",
            "description": "True when the user declared \"I am 18 or older\". Anything else → 403 `adult_required`. No date of birth is collected."
          },
          "noticeVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,40}$",
            "description": "Version of the consent notice the user was shown.",
            "examples": [
              "2026-10-v1"
            ]
          },
          "noticeLocale": {
            "type": "string",
            "enum": [
              "en",
              "bn"
            ],
            "description": "Language the notice was shown in.",
            "examples": [
              "en"
            ]
          },
          "purposes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,40}$",
              "description": "What the consent is for. Open set; currently accepted: `account_core`, `sos_alerts`, `live_sharing`, `safety_reports`.",
              "examples": [
                "account_core"
              ]
            },
            "minItems": 1,
            "maxItems": 4,
            "description": "Purposes the user agreed to. Must contain `account_core`.",
            "examples": [
              [
                "account_core"
              ]
            ]
          }
        },
        "required": [
          "noticeVersion",
          "noticeLocale",
          "purposes"
        ],
        "description": "The age declaration and the consent the user gave on the onboarding notice. Needed to create an account; ignored when the account already exists."
      },
      "ConsentList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Consent"
            },
            "description": "One entry per purpose the user has ever decided on, ordered by purpose."
          }
        },
        "required": [
          "items"
        ],
        "description": "The signed-in user's current consents."
      },
      "Consent": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "description": "What the consent is for. Clients must tolerate unknown values.",
            "examples": [
              "account_core"
            ]
          },
          "status": {
            "type": "string",
            "description": "`granted` or `withdrawn`. Clients must tolerate unknown values.",
            "examples": [
              "granted"
            ]
          },
          "noticeVersion": {
            "type": "string",
            "description": "Version of the notice this decision was made under.",
            "examples": [
              "2026-10-v1"
            ]
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 UTC timestamp of the decision.",
            "examples": [
              "2026-10-06T09:30:00.000Z"
            ]
          }
        },
        "required": [
          "purpose",
          "status",
          "noticeVersion",
          "decidedAt"
        ],
        "description": "The user's latest decision for one purpose."
      },
      "SetConsentRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "granted",
              "withdrawn"
            ],
            "examples": [
              "granted"
            ]
          },
          "noticeVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,40}$",
            "description": "Version of the consent notice the user was shown.",
            "examples": [
              "2026-10-v1"
            ]
          },
          "noticeLocale": {
            "type": "string",
            "enum": [
              "en",
              "bn"
            ],
            "description": "Language the notice was shown in.",
            "examples": [
              "en"
            ]
          }
        },
        "required": [
          "status",
          "noticeVersion",
          "noticeLocale"
        ],
        "description": "The user's decision for the purpose in the path."
      },
      "SearchResults": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Place"
            },
            "maxItems": 10,
            "description": "Places near the requested point first, then places from further away; within each group, best match first. Empty when nothing was found."
          },
          "attribution": {
            "type": [
              "string",
              "null"
            ],
            "description": "Credit line the app must show next to the results when it is not null (required by the terms of the geocoding provider and of the map data).",
            "examples": [
              "© OpenStreetMap contributors"
            ]
          }
        },
        "required": [
          "results",
          "attribution"
        ],
        "description": "Places that match a search."
      },
      "Place": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque identifier from the geocoding provider. Do not parse or store it.",
            "examples": [
              "a1b2c3"
            ]
          },
          "name": {
            "type": "string",
            "description": "Short name of the place.",
            "examples": [
              "Main Station"
            ]
          },
          "label": {
            "type": "string",
            "description": "Longer text that places the name (area, district, state). May be empty.",
            "examples": [
              "Station Road, Example District"
            ]
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "examples": [
              10.5
            ]
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "examples": [
              20.5
            ]
          },
          "kind": {
            "type": "string",
            "description": "Kind of place. Open set: clients must tolerate unknown values.",
            "examples": [
              "amenity"
            ]
          },
          "distanceMeters": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20100000,
            "description": "Straight-line distance in metres from the rounded `nearLatitude`/`nearLongitude` of the request to this place, rounded to 100 m. Present only when the request carried that point. It is measured from the rounded point, so it is approximate: about 1 km either way.",
            "examples": [
              2300
            ]
          }
        },
        "required": [
          "id",
          "name",
          "label",
          "latitude",
          "longitude",
          "kind"
        ],
        "description": "One search result."
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 400,
            "description": "What the user typed. After trimming, collapsing whitespace and Unicode NFC normalisation it must be 2 to 100 Unicode code points with no control characters. Any script is accepted.",
            "examples": [
              "railway station"
            ]
          },
          "nearLatitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Latitude of the area to prefer, WGS84 decimal degrees; send it together with `nearLongitude` or not at all. Places near it come first; places further away follow when too few are near. The server rounds it to two decimals (about 1 km) before using it; send a coarse point (the map centre, or a position already rounded to two decimals), never a precise position.",
            "examples": [
              10.5
            ]
          },
          "nearLongitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Longitude of the area to prefer; see `nearLatitude`.",
            "examples": [
              20.5
            ]
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "bn"
            ],
            "default": "en",
            "description": "Preferred language of the result names.",
            "examples": [
              "en"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 6,
            "description": "Maximum number of results.",
            "examples": [
              6
            ]
          }
        },
        "required": [
          "q"
        ],
        "description": "A place search. Sent as a request body so that the text and the area never appear in a URL."
      },
      "Routes": {
        "type": "object",
        "properties": {
          "routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Route"
            },
            "minItems": 1,
            "maxItems": 3,
            "description": "Fastest first, then up to two alternatives."
          },
          "attribution": {
            "type": "string",
            "description": "Credit line the app must show with the routes (required by the map data).",
            "examples": [
              "© OpenStreetMap contributors"
            ]
          }
        },
        "required": [
          "routes",
          "attribution"
        ],
        "description": "Routes between two points."
      },
      "Route": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque identifier of this route within this response, for selecting it in the app. It means nothing to the server afterwards: routes are not stored.",
            "examples": [
              "5d2f0c1e-3b7a-4c8d-9e1f-2a6b4c8d0e1f"
            ]
          },
          "distanceMeters": {
            "type": "integer",
            "minimum": 0,
            "examples": [
              2100
            ]
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Estimated travel time without traffic. An estimate, not a promise.",
            "examples": [
              1560
            ]
          },
          "geometry": {
            "type": "object",
            "properties": {
              "encoding": {
                "type": "string",
                "enum": [
                  "polyline6"
                ],
                "description": "Encoded polyline with six decimals: latitude then longitude, as differences."
              },
              "value": {
                "type": "string",
                "examples": [
                  "_izlhA~rlgdF_{geC~ywl@"
                ]
              }
            },
            "required": [
              "encoding",
              "value"
            ],
            "description": "The whole line of the route."
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Box around the route: [minLongitude, minLatitude, maxLongitude, maxLatitude].",
            "examples": [
              [
                20.5,
                10.5,
                20.6,
                10.6
              ]
            ]
          }
        },
        "required": [
          "id",
          "distanceMeters",
          "durationSeconds",
          "geometry",
          "bbox"
        ],
        "description": "One way to travel between the two points. Says nothing about safety."
      },
      "RouteRequest": {
        "type": "object",
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/RoutePoint"
          },
          "destination": {
            "$ref": "#/components/schemas/RoutePoint"
          },
          "mode": {
            "type": "string",
            "enum": [
              "walking",
              "driving"
            ],
            "description": "How the person travels. Driving means a car on roads open to cars.",
            "examples": [
              "walking"
            ]
          },
          "departAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the trip starts, RFC 3339 with an offset. Validated and otherwise ignored for now: routes do not depend on the time of day yet.",
            "examples": [
              "2026-01-01T18:30:00+05:30"
            ]
          }
        },
        "required": [
          "origin",
          "destination",
          "mode"
        ],
        "description": "A request for routes between two points. Sent as a request body so that no position ever appears in a URL. The two points must be at least 20 m apart."
      },
      "RoutePoint": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "WGS84 decimal degrees.",
            "examples": [
              10.5
            ]
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "WGS84 decimal degrees.",
            "examples": [
              20.5
            ]
          }
        },
        "required": [
          "latitude",
          "longitude"
        ],
        "description": "A position on the map."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "schema": {
          "$ref": "#/components/schemas/IdempotencyKey"
        },
        "required": true,
        "description": "Client-generated key (e.g. a UUID) for a retryable state-changing call. The server stores key → response for 24 h and replays the stored response for a repeat (Plan v7 §6.2).",
        "name": "Idempotency-Key",
        "in": "header"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "operational"
        ],
        "summary": "Liveness probe",
        "description": "Answers \"is this process up and serving HTTP?\". Does no I/O (no database, no provider), so a slow dependency never makes the platform restart a healthy instance.",
        "security": [],
        "responses": {
          "200": {
            "description": "The process is up.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
