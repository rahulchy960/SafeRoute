{
  "openapi": "3.1.0",
  "info": {
    "title": "SafeRoute API",
    "version": "0.3.0",
    "description": "SafeRoute is a personal-safety navigation API. Safety information is context, never a guarantee that a route or area is safe. SafeRoute is not an emergency service; in an emergency call your local emergency number (112 in India).",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "operational",
      "description": "Unversioned probes for the platform (liveness, readiness). Not for app features."
    },
    {
      "name": "me",
      "description": "The signed-in user's own account and consents. Every operation needs a Firebase ID token (phone sign-in)."
    }
  ],
  "components": {
    "headers": {
      "RequestId": {
        "description": "Correlation ID for this request. Echoes a well-formed incoming `X-Request-Id` (8–64 characters of `A–Z a–z 0–9 . _ -`), otherwise a fresh UUID.",
        "schema": {
          "type": "string"
        }
      },
      "CacheControlNoStore": {
        "description": "Always `no-store`: the response must never be cached.",
        "schema": {
          "type": "string",
          "enum": [
            "no-store"
          ]
        }
      },
      "WwwAuthenticate": {
        "description": "Always `Bearer`: send a Firebase ID token as `Authorization: Bearer <token>`.",
        "schema": {
          "type": "string",
          "enum": [
            "Bearer"
          ]
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input (`validation_error`).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid credentials (`unauthorized`). Refresh the ID token and retry once.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          },
          "WWW-Authenticate": {
            "$ref": "#/components/headers/WwwAuthenticate"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated but not allowed: `forbidden`, `bootstrap_required`, `account_deleted`, `consent_required` or `adult_required`. Final: retrying the same request does not help.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such route or resource (`not_found`).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflicts with the current state (`conflict`, `phone_already_registered`, `account_deletion_required`).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Gone": {
        "description": "The resource existed but has expired or ended (`gone`).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded (`rate_limited`).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error (`internal_error`).",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "A dependency is unavailable (e.g. `db_unavailable`, `db_not_configured`, `auth_unavailable`, `auth_not_configured`). Retry with backoff.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "firebaseBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase ID token from phone sign-in, sent as `Authorization: Bearer <token>`. 401 → refresh the token and retry once; 503 `auth_unavailable` → retry with backoff."
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Problem type URI. `about:blank` means `title` is the HTTP status phrase.",
            "examples": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string",
            "examples": [
              "Not Found"
            ]
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "examples": [
              404
            ]
          },
          "detail": {
            "type": "string",
            "description": "Human-readable, generic explanation. Never contains personal data.",
            "examples": [
              "No route matches this request."
            ]
          },
          "code": {
            "type": "string",
            "description": "Stable, machine-readable error code; clients switch on this, not on `title` or `detail`. Open set: clients must tolerate unknown values. Currently defined: `validation_error`, `unauthorized`, `forbidden`, `bootstrap_required`, `account_deleted`, `consent_required`, `adult_required`, `not_found`, `conflict`, `phone_already_registered`, `account_deletion_required`, `gone`, `rate_limited`, `internal_error`, `db_unavailable`, `db_not_configured`, `auth_unavailable`, `auth_not_configured`, `http_error`.",
            "examples": [
              "not_found"
            ]
          },
          "requestId": {
            "type": "string",
            "description": "Same value as the `X-Request-Id` response header; quote it in bug reports.",
            "examples": [
              "3f2c1b9e-7a44-4c1e-9d2f-0b6a5e8c1d23"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            },
            "description": "Present for `validation_error`: one entry per invalid input."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "requestId"
        ],
        "description": "Error body for every 4xx/5xx response (media type `application/problem+json`)."
      },
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Location of the invalid input, e.g. `body.contacts.0.name` or `query.limit`.",
            "examples": [
              "body.name"
            ]
          },
          "code": {
            "type": "string",
            "description": "Why it is invalid (e.g. `invalid_type`, `too_small`). Open set.",
            "examples": [
              "invalid_type"
            ]
          }
        },
        "required": [
          "path",
          "code"
        ],
        "description": "One invalid input. Never contains the submitted value."
      },
      "IdempotencyKey": {
        "type": "string",
        "minLength": 16,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._-]{16,64}$",
        "description": "Client-generated key (e.g. a UUID) for a retryable state-changing call. The server stores key → response for 24 h and replays the stored response for a repeat (Plan v7 §6.2).",
        "examples": [
          "2b1f6c4e-8d3a-4f7b-9c21-5e0a7d4b3c19"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "examples": [
              "saferoute-api"
            ]
          },
          "version": {
            "type": "string",
            "description": "Deployed build version of the service (not the contract version).",
            "examples": [
              "0.1.0"
            ]
          },
          "uptimeSeconds": {
            "type": "integer",
            "minimum": 0,
            "description": "Seconds since this instance started.",
            "examples": [
              42
            ]
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "uptimeSeconds"
        ]
      },
      "Readiness": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "ok"
                ]
              }
            },
            "required": [
              "database"
            ],
            "description": "One entry per dependency this instance needs to serve traffic."
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Stable account ID.",
            "examples": [
              "0f8c2a4e-6b1d-4c3a-9e7f-2d5b8a1c4e60"
            ]
          },
          "phoneE164": {
            "type": [
              "string",
              "null"
            ],
            "description": "Verified phone number in E.164 form, from the sign-in token.",
            "examples": [
              "+910000000001"
            ]
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "Sample Name"
            ]
          },
          "locale": {
            "type": "string",
            "description": "UI language: `en` or `bn`. Clients must tolerate unknown values.",
            "examples": [
              "en"
            ]
          },
          "role": {
            "type": "string",
            "description": "`user`, `moderator` or `admin`. Clients must tolerate unknown values.",
            "examples": [
              "user"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 UTC timestamp.",
            "examples": [
              "2026-10-01T09:30:00.000Z"
            ]
          }
        },
        "required": [
          "id",
          "phoneE164",
          "displayName",
          "locale",
          "role",
          "createdAt"
        ],
        "description": "The signed-in user's account."
      },
      "BootstrapMeRequest": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "bn"
            ],
            "description": "UI language for the new account. Default `en`. Ignored if it already exists.",
            "examples": [
              "bn"
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Name shown to the user's emergency contacts. Trimmed; 1–80 characters; no control characters. Ignored if the account already exists.",
            "examples": [
              "Sample Name"
            ]
          },
          "consent": {
            "$ref": "#/components/schemas/BootstrapConsent"
          }
        },
        "description": "Settings and consent for a new account. `consent` is needed to create an account (optional in the schema only because an existing account does not need it). The phone number is never sent: the server takes it from the verified ID token. Unknown properties are ignored."
      },
      "BootstrapConsent": {
        "type": "object",
        "properties": {
          "ageConfirmed": {
            "type": "boolean",
            "description": "True when the user declared \"I am 18 or older\". Anything else → 403 `adult_required`. No date of birth is collected."
          },
          "noticeVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,40}$",
            "description": "Version of the consent notice the user was shown.",
            "examples": [
              "2026-10-v1"
            ]
          },
          "noticeLocale": {
            "type": "string",
            "enum": [
              "en",
              "bn"
            ],
            "description": "Language the notice was shown in.",
            "examples": [
              "en"
            ]
          },
          "purposes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,40}$",
              "description": "What the consent is for. Open set; currently accepted: `account_core`, `sos_alerts`, `live_sharing`, `safety_reports`.",
              "examples": [
                "account_core"
              ]
            },
            "minItems": 1,
            "maxItems": 4,
            "description": "Purposes the user agreed to. Must contain `account_core`.",
            "examples": [
              [
                "account_core"
              ]
            ]
          }
        },
        "required": [
          "noticeVersion",
          "noticeLocale",
          "purposes"
        ],
        "description": "The age declaration and the consent the user gave on the onboarding notice. Needed to create an account; ignored when the account already exists."
      },
      "ConsentList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Consent"
            },
            "description": "One entry per purpose the user has ever decided on, ordered by purpose."
          }
        },
        "required": [
          "items"
        ],
        "description": "The signed-in user's current consents."
      },
      "Consent": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "description": "What the consent is for. Clients must tolerate unknown values.",
            "examples": [
              "account_core"
            ]
          },
          "status": {
            "type": "string",
            "description": "`granted` or `withdrawn`. Clients must tolerate unknown values.",
            "examples": [
              "granted"
            ]
          },
          "noticeVersion": {
            "type": "string",
            "description": "Version of the notice this decision was made under.",
            "examples": [
              "2026-10-v1"
            ]
          },
          "decidedAt": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 UTC timestamp of the decision.",
            "examples": [
              "2026-10-06T09:30:00.000Z"
            ]
          }
        },
        "required": [
          "purpose",
          "status",
          "noticeVersion",
          "decidedAt"
        ],
        "description": "The user's latest decision for one purpose."
      },
      "SetConsentRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "granted",
              "withdrawn"
            ],
            "examples": [
              "granted"
            ]
          },
          "noticeVersion": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,40}$",
            "description": "Version of the consent notice the user was shown.",
            "examples": [
              "2026-10-v1"
            ]
          },
          "noticeLocale": {
            "type": "string",
            "enum": [
              "en",
              "bn"
            ],
            "description": "Language the notice was shown in.",
            "examples": [
              "en"
            ]
          }
        },
        "required": [
          "status",
          "noticeVersion",
          "noticeLocale"
        ],
        "description": "The user's decision for the purpose in the path."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "schema": {
          "$ref": "#/components/schemas/IdempotencyKey"
        },
        "required": true,
        "description": "Client-generated key (e.g. a UUID) for a retryable state-changing call. The server stores key → response for 24 h and replays the stored response for a repeat (Plan v7 §6.2).",
        "name": "Idempotency-Key",
        "in": "header"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "operational"
        ],
        "summary": "Liveness probe",
        "description": "Answers \"is this process up and serving HTTP?\". Does no I/O (no database, no provider), so a slow dependency never makes the platform restart a healthy instance.",
        "security": [],
        "responses": {
          "200": {
            "description": "The process is up.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
          "operational"
        ],
        "summary": "Readiness probe",
        "description": "Answers \"can this instance serve traffic that needs the database?\". Returns 503 (`db_unavailable` or `db_not_configured`) when it cannot. Never includes connection details.",
        "security": [],
        "responses": {
          "200": {
            "description": "The instance and its database are ready.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/me/bootstrap": {
      "post": {
        "operationId": "bootstrapMe",
        "tags": [
          "me"
        ],
        "summary": "Create the signed-in user's account if needed",
        "description": "Call after every sign-in. Creates the account for the token's Firebase user (201) or returns the existing one unchanged (200); safe to retry. The phone number comes from the verified token, never from the body. Creating an account needs `consent` from the onboarding notice: without it → `consent_required` (403); without `ageConfirmed: true` → `adult_required` (403); in both cases nothing is stored. For an existing account `consent` is ignored. Other errors: `phone_already_registered` (409) when another account holds the number, `account_deleted` (403).",
        "security": [
          {
            "firebaseBearer": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapMeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The account already existed; returned unchanged.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "201": {
            "description": "The account was created.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "me"
        ],
        "summary": "Get the signed-in user's account",
        "description": "Errors: `bootstrap_required` (403) before POST /v1/me/bootstrap, `account_deleted` (403).",
        "security": [
          {
            "firebaseBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "The account.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/me/consents": {
      "get": {
        "operationId": "getMyConsents",
        "tags": [
          "me"
        ],
        "summary": "List the signed-in user's consents",
        "description": "The latest decision for each purpose the user has decided on. A purpose that was never asked is absent; treat it as not granted.",
        "security": [
          {
            "firebaseBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "The current consents.",
            "headers": {
              "Cache-Control": {
                "$ref": "#/components/headers/CacheControlNoStore"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/me/consents/{purpose}": {
      "put": {
        "operationId": "setMyConsent",
        "tags": [
          "me"
        ],
        "summary": "Grant or withdraw consent for one purpose",
        "description": "Records the decision and returns the latest state; safe to retry. Ask just-in-time, when the feature that needs the purpose is first used. Errors: `validation_error` (400) for an unknown purpose; `account_deletion_required` (409) when withdrawing `account_core`, which can only be withdrawn by deleting the account.",
        "security": [
          {
            "firebaseBearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
