# Copy to .env for local overrides (never commit .env). All values are optional; defaults shown.
# Load it with: node --env-file=.env dist/server.js  (or export the variables in your shell)

# development | test | production
NODE_ENV=development
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
SERVICE_NAME=saferoute-api
# Set by CI/CD at deploy time (P006); defaults are "dev" and "unknown".
APP_VERSION=dev
GIT_SHA=unknown
