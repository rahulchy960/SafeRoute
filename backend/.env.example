# Local development settings. `pnpm dev` and `pnpm db:migrate` load this file automatically, then
# `.env` (git-ignored) on top of it for your own overrides. Never put real credentials here.

# development | test | production
NODE_ENV=development
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
SERVICE_NAME=saferoute-api
# Set by CI/CD at deploy time (P006); defaults are "dev" and "unknown".
APP_VERSION=dev
GIT_SHA=unknown

# LOCAL ONLY: the throwaway credentials of the docker-compose.yml database (pnpm db:up).
# Required when NODE_ENV=production (then provided by Secret Manager, P006).
DATABASE_URL=postgres://saferoute_local:local-only-password@127.0.0.1:5433/saferoute_dev
# Connections per API instance (1-20). Kept small because many instances share one database.
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_MS=5000
